# Referência das variáveis suportadas. O projeto não carrega .env automaticamente
# (não há dotenv): passe pelo ambiente, com `docker run --env-file .env` ou pelo
# bloco "env" da configuração do servidor MCP.

# --- Banco ---
# Caminho do SQLite. No container o default já é /app/data/ingestion.db
DB_PATH=data/ingestion.db
# Espera por lock antes de falhar; leituras do servidor MCP concorrem com a ingestão
DB_BUSY_TIMEOUT_MS=5000

# --- Regra de negócio ---
# Validade do crédito criado na ingestão e no onboarding
BONUS_EXPIRY_DAYS=180
# Offset usado por --expired-rate para nascer vencido (negativo = passado)
BONUS_ALREADY_EXPIRED_DAYS=-200
# Valores gravados no CSV gerado por gencsv
BONUS_CYCLE=2026-06
BONUS_ORIGIN=vivo

# --- Ingestão ---
INGEST_BATCH_SIZE=500

# --- Servidor MCP ---
# Raiz onde as tools podem ler e escrever. Caminhos fora dela são rejeitados.
INGEST_ROOT=data
MCP_SERVER_NAME=bonus-ingestion
MCP_SERVER_VERSION=1.0.0
# Teto de itens devolvidos por qualquer tool de listagem
MCP_LIST_LIMIT=100
MCP_MAX_GENERATED_ROWS=10000000
MCP_MAX_CONCURRENT_INGESTIONS=1
